import bpy, io_scene_gltf2, json
from mathutils import Vector
c=bpy.data.collections['export_pistol_coral_stub']
result={'blender_version':bpy.app.version_string,'build_hash':bpy.app.build_hash.decode(),'exporter_file':io_scene_gltf2.__file__,'exporter_version':io_scene_gltf2.bl_info['version'],'units':{'system':bpy.context.scene.unit_settings.system,'scale':bpy.context.scene.unit_settings.scale_length},'libraries':[l.filepath for l in bpy.data.libraries],'images':[i.filepath for i in bpy.data.images],'objects':[],'materials':[]}
for o in sorted(c.all_objects,key=lambda o:o.name):
 result['objects'].append({'name':o.name,'type':o.type,'parent':o.parent.name if o.parent else None,'location':list(o.location),'rotation':list(o.rotation_euler),'scale':list(o.scale),'determinant':o.matrix_world.determinant(),'modifiers':[m.type for m in o.modifiers],'slots':[m.name for m in o.data.materials] if o.type=='MESH' else [],'faces':len(o.data.polygons) if o.type=='MESH' else 0,'bound_world':[list(o.matrix_world@Vector(v)) for v in o.bound_box] if o.type=='MESH' else None})
for m in bpy.data.materials:
 p=next((n for n in m.node_tree.nodes if n.type=='BSDF_PRINCIPLED'),None)
 result['materials'].append({'name':m.name,'base_color':list(p.inputs['Base Color'].default_value),'metallic':p.inputs['Metallic'].default_value,'roughness':p.inputs['Roughness'].default_value,'emission_strength':p.inputs['Emission Strength'].default_value})
print('INDEPENDENT_SOURCE '+json.dumps(result,sort_keys=True))
assert bpy.app.version_string=='5.2.2 LTS' and bpy.app.build_hash==b'd13f752e3b9c'
assert io_scene_gltf2.bl_info['version']==(5,2,40)
assert not bpy.data.libraries and not bpy.data.images
assert bpy.context.scene.unit_settings.system=='METRIC' and bpy.context.scene.unit_settings.scale_length==1
assert len([o for o in c.all_objects if o.type=='MESH'])==12
assert len([o for o in c.all_objects if o.type=='EMPTY'])==2
for o in c.all_objects:
 assert all(abs(v)<1e-6 for v in o.rotation_euler),o.name
 assert all(abs(v-1)<1e-6 for v in o.scale),o.name
 assert not o.modifiers and not o.animation_data,o.name
print('INDEPENDENT_SOURCE_CHECK passed')

